{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/parents", "destination": "/parents/index.html" },
    { "source": "/membership", "destination": "/membership/index.html" },
    { "source": "/join", "destination": "/join/index.html" },
    { "source": "/directory", "destination": "/directory/index.html" },
    { "source": "/events", "destination": "/events/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/((?!api/|assets/|images/|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
